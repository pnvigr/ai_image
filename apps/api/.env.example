# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB (опционально локально — без него история отключена, всё остальное работает)
MONGODB_URI=

# OpenRouter (опционально — без ключа API возвращает mock-ответы)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_PAID_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Chart Analysis (diploma)
