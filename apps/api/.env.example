# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth (JWT). В проде ОБЯЗАТЕЛЬНО задайте длинный случайный JWT_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

# MongoDB (опционально локально — без него история отключена, всё остальное работает)
MONGODB_URI=

# OpenRouter (опционально — без ключа API возвращает mock-ответы)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_PAID_MODEL=openai/gpt-4o-mini
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Массивы моделей (через запятую) — сидируются в БД при первом запуске.
# free перебираются по порядку до первого успеха; paid даются пользователю на выбор.
OPENROUTER_FREE_MODELS=
OPENROUTER_PAID_MODELS=
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Chart Analysis (diploma)

# Биллинг / админка
# email, который автоматически станет администратором при регистрации/входе
ADMIN_EMAIL=
SUPPORT_CONTACT=Telegram: @your_support_handle
FREE_DAILY_LIMIT=20
PAID_ANALYSIS_COST=1
